# Exemplo 05 — Clone de template cloud-init entre nós do cluster
# O template de origem fica no pve01; a VM é criada no pve02.

terraform {
  required_version = ">= 1.0"

  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "~> 0.78"
    }
  }
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token
  insecure  = true

  ssh {
    agent = false
  }
}
